--- xv6-pristine/kalloc.c
+++ xv6-assignment8/kalloc.c
@@
+static uint refcount[PAGES];
+int cowfault(pde_t *pgdir, uint va) {
+  pte_t *pte=walkpgdir(pgdir,(char*)va,0); uint old,newpa;
+  if(!pte || !(*pte&PTE_COW)) return -1;
+  old=PTE_ADDR(*pte); if(refcount[old/PGSIZE]==1){*pte=old|PTE_P|PTE_W|PTE_U;return 0;}
+  if((newpa=(uint)kalloc())==0) return -1; memmove((char*)P2V(newpa),(char*)P2V(old),PGSIZE);
+  refcount[old/PGSIZE]--; *pte=newpa|PTE_P|PTE_W|PTE_U; return 0;
+}
