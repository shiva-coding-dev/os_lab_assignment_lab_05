--- xv6-pristine/proc.c
+++ xv6-assignment7/proc.c
@@
+static int
+valid_stack(uint sp)
+{
+  return sp % 4 == 0;
+}
+
+int
+clone(void (*fcn)(void*), void *arg, void *stack)
+{
+  struct proc *p = myproc(), *np;
+  uint sp;
+  if(!fcn || !stack || !valid_stack((uint)stack)) return -1;
+  if((np = allocproc()) == 0) return -1;
+  np->pgdir = p->pgdir;
+  np->sz = p->sz;
+  np->parent = p;
+  np->threadparent = p->threadparent ? p->threadparent : p;
+  np->isthread = 1;
+  *np->tf = *p->tf;
+  sp = (uint)stack - 4;
+  if(copyout(np->pgdir, sp, (char*)&arg, 4) < 0) { np->state = UNUSED; return -1; }
+  np->tf->eip = (uint)fcn;
+  np->tf->esp = sp;
+  np->tf->eax = 0;
+  safestrcpy(np->name, "thread", sizeof(np->name));
+  acquire(&ptable.lock); np->state = RUNNABLE; release(&ptable.lock);
+  return np->pid;
+}
+
+int
+join(void)
+{
+  struct proc *p, *cur = myproc();
+  int found;
+  acquire(&ptable.lock);
+  for(;;) {
+    found = 0;
+    for(p = ptable.proc; p < &ptable.proc[NPROC]; p++)
+      if(p->parent == cur && p->isthread) {
+        found = 1;
+        if(p->state == ZOMBIE) { kfree(p->kstack); p->kstack=0; p->state=UNUSED; release(&ptable.lock); return 0; }
+      }
+    if(!found || cur->killed) { release(&ptable.lock); return -1; }
+    sleep(cur, &ptable.lock);
+  }
+}
