+int sys_clone(void){ void(*f)(void*); void *arg,*stack; if(argptr(0,(void*)&f,sizeof(f))<0||argptr(1,(void*)&arg,sizeof(arg))<0||argptr(2,(void*)&stack,sizeof(stack))<0)return -1; return clone(f,arg,stack); }
+int sys_join(void){ return join(); }
+int sys_sem_init(void){int id,v;if(argint(0,&id)<0||argint(1,&v)<0)return -1;return sem_init(id,v);}
+int sys_sem_wait(void){int id;if(argint(0,&id)<0)return -1;return sem_wait(id);}
+int sys_sem_signal(void){int id;if(argint(0,&id)<0)return -1;return sem_signal(id);}
+int sys_set_priority(void){int pid,pr;if(argint(0,&pid)<0||argint(1,&pr)<0||pr<1||pr>20)return -1;return setpriority(pid,pr);}
+int sys_get_priority(void){int pid;if(argint(0,&pid)<0)return -1;return getpriority(pid);}
