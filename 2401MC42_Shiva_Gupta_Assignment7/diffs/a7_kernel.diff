--- xv6-pristine/sync.c
+++ xv6-assignment7/sync.c
+#include "types.h"
+#include "defs.h"
+#include "param.h"
+#include "spinlock.h"
+#include "proc.h"
+#define NSEMS 10
+struct semaphore { int value; struct spinlock lock; int used; };
+static struct semaphore sems[NSEMS];
+void seminitall(void) { int i; for(i=0;i<NSEMS;i++){initlock(&sems[i].lock,"sem");sems[i].used=0;} }
+int sem_init(int id,int value) { if(id<0||id>=NSEMS||value<0)return -1; acquire(&sems[id].lock); sems[id].value=value; sems[id].used=1; release(&sems[id].lock); return 0; }
+int sem_wait(int id) { if(id<0||id>=NSEMS||!sems[id].used)return -1; acquire(&sems[id].lock); while(sems[id].value==0){sleep(&sems[id],&sems[id].lock); if(myproc()->killed){release(&sems[id].lock);return -1;}} sems[id].value--; release(&sems[id].lock); return 0; }
+int sem_signal(int id) { if(id<0||id>=NSEMS||!sems[id].used)return -1; acquire(&sems[id].lock); sems[id].value++; wakeup(&sems[id]); release(&sems[id].lock); return 0; }
